cat > .gitignore << 'EOF'
# TOJIBOT - Archivos ignorados

# Dependencias
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Sesiones de WhatsApp - NUNCA SUBIR ESTO
Sessions/
Session/
creds.json
*.json.bak

# Temporales
tmp/
temp/
.cache.json

# Logs
logs/
npm-debug.log*
yarn-error.log*
*.log

# Sistema
.DS_Store
Thumbs.db
.env
.env.local

# TOJIBOT DB
database.json
*.db
*.sqlite
EOF
cat .gitignore
